# 生产环境配置  

# 唯一域名（用户端、管理端、API 同源部署，替换成你自己的域名）
VITE_APP_BASE_URL=https://maruko.xiaofei.icu
# 管理后台url（挂载在同一域名的 /admin/ 子路径下）
VITE_APP_ADMIN_URL=https://maruko.xiaofei.icu/admin/
# Token
VITE_APP_TOKEN=maruko_token
# 用户信息
VITE_APP_USER=maruko_user
# 主播的房间号
VITE_APP_ROOM_ID=1929354869  
# 主播的用户id
VITE_APP_USER_ID=3546938511198692 
# 网站标题
VITE_APP_TITLE=小猫丸子Wiki
# 主播全程
VITE_APP_HOST_NAME=猫丸子Maruko
# 主播昵称
VITE_APP_NICK_NAME=丸子
# 粉丝昵称
VITE_APP_DD_NAME=猫丸伴
# 版本号缓存键
VITE_VERSION_STORAGE_KEY=app_version
